<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sayserne.Api</RootNamespace>
    <UserSecretsId>sayserne-api-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- The only data-access dependency: a MySQL driver. No ORM, no query builder. -->
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
</Project>
