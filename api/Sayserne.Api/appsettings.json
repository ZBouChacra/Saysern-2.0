{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Web": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Google": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": ""
  },
  "Auth": {
    "PasswordIterations": 600000
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Admin": {
    "AllowedOrigins": [
      "http://localhost:5174"
    ]
  },
  "Settings": {
    "RefreshSeconds": 15
  },
  "Storage": {
    "DiskPath": "storage"
  },
  "Media": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "ProcessTimeoutSeconds": 600
  },
  "Jobs": {
    "Enabled": true,
    "PollSeconds": 2,
    "Workers": 2,
    "SchedulerEnabled": true,
    "SchedulerMinutes": 15
