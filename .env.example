# Reference only. The API does NOT load .env files by itself; set these as environment variables
# (shell, IIS/Windows service, Docker, CI) or, for local development, with `dotnet user-secrets`.
# Never commit real values. .env is git-ignored.

# ---- API runtime (the stored-procedure-only account) ----
ConnectionStrings__Default=Server=127.0.0.1;Port=3306;Database=sayserne;User ID=sayserne_app;Password=CHANGE_ME
Google__ClientId=
Google__ClientSecret=
# Must equal an "Authorized redirect URI" in the Google console. Dev: the Vite origin + /api/auth/google/callback
Google__RedirectUri=http://localhost:5173/api/auth/google/callback
Web__AllowedOrigins__0=http://localhost:5173
# The back office is its own web app; its origin must be allowed to POST to the API (dev default shown)
Admin__AllowedOrigins__0=http://localhost:5174
# Deploy-time tuning (defaults shown). Everything else - lockout, session length, rate limits, password rules, booking
# and chat limits ... - is a RUNTIME SETTING edited in the back office (Settings), not an environment variable.
# Auth__PasswordIterations=600000
# Settings__RefreshSeconds=15            # how often each API instance re-reads the settings (other instances pick up an edit within this time)
# Production only
# Proxy__TrustForwardedHeaders=true      # only if the API is reachable exclusively through your reverse proxy
# DataProtection__KeysPath=/var/lib/sayserne/dp-keys   # shared, persistent, access-restricted folder. REQUIRED in production: it also protects the admins' two-factor secrets

# ---- Files and media (phase 3b) ----
# Which provider receives NEW uploads is a runtime setting (back office -> Settings -> Storage.Provider: disk | s3).
# Storage__DiskPath=storage                        # folder for the "disk" provider; relative to the API folder or absolute. BACK IT UP.
# Storage__S3__Endpoint=https://s3.eu-central-1.amazonaws.com   # any S3-compatible store (AWS, MinIO, R2, Backblaze, Spaces...)
# Storage__S3__Bucket=sayserne
# Storage__S3__Region=eu-central-1
# Storage__S3__AccessKey=
# Storage__S3__SecretKey=                          # secret: environment / secret store only
# Media__FfmpegPath=ffmpeg                         # ffmpeg and ffprobe MUST be installed on the server (images and videos are processed with them)
# Media__FfprobePath=ffprobe
# Media__ProcessTimeoutSeconds=600
# Jobs__Enabled=true                               # run the background-job worker inside this API process
# Jobs__PollSeconds=2
# Jobs__Workers=2                                  # jobs taken per cycle

# ---- Migrator CLI (schema owner; used for provision / migrate / promote-admin / reset-2fa) ----
SAYSERNE_ADMIN_CONNECTION=Server=127.0.0.1;Port=3306;User ID=root;Password=CHANGE_ME
SAYSERNE_DB_NAME=sayserne
SAYSERNE_MIGRATOR_USER=sayserne_migrator
SAYSERNE_MIGRATOR_PASSWORD=CHANGE_ME_12_to_64_chars
SAYSERNE_APP_USER=sayserne_app
SAYSERNE_APP_PASSWORD=CHANGE_ME_12_to_64_chars
# SAYSERNE_USER_HOST=localhost            # host part of the two MySQL accounts (use % if the API runs on another machine)
SAYSERNE_MIGRATOR_CONNECTION=Server=127.0.0.1;Port=3306;Database=sayserne;User ID=sayserne_migrator;Password=CHANGE_ME_12_to_64_chars

# ---- Tests ----
# An administrator that may create/drop throw-away databases and users (sayserne_test_*)
SAYSERNE_TEST_ADMIN_CONNECTION=Server=127.0.0.1;Port=3306;User ID=root;Password=CHANGE_ME
# SAYSERNE_TEST_USER_HOST=localhost

# ---- Optional (phase 4) ----
# OpenApi__Enabled=true      # serve the API description at /api/openapi.json (docs/openapi.json is the committed copy)
